{
  "project": "cloudbound",
  "profile_version": 1,
  "asset_type": "character",
  "style": "stylized",
  "perspective": "isometric_2_5d",
  "atlas": {
    "frame_width": 128,
    "frame_height": 128,
    "columns": 4,
    "rows": 1,
    "padding": 0,
    "safe_margin": 4,
    "format": "png_rgba"
  },
  "animations": {
    "idle": { "frames": 4, "fps": 6, "loop": true },
    "walk": { "frames": 4, "fps": 8, "loop": true },
    "attack": { "frames": 4, "fps": 12, "loop": false },
    "hurt": { "frames": 2, "fps": 10, "loop": false },
    "death": { "frames": 4, "fps": 8, "loop": false }
  },
  "directions": ["down", "right", "up"],
  "direction_angles": { "down": 0, "right": 90, "up": 180 },
  "allow_horizontal_flip": true,
  "flip_policy": "flip_uv",
  "pivot": { "anchor_mode": "bottom_center_feet", "x": 64, "y": 112 },
  "godot": { "texture_filter": "nearest" },
  "output": { "naming": "{character}_{animation}_{direction}", "format": "png", "metadata": "json" }
}
